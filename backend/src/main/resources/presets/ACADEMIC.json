      "required": true,
      "rating": { "min": 1, "max": 5, "minLabel": "Theoretical Only", "maxLabel": "Highly Practical" }
    },
    {
      "key": "overall_rating",
      "type": "RATING",
      "section": "Summary",
      "prompt": "Rate your overall academic learning experience in this department this semester.",
      "required": true,
      "rating": { "min": 1, "max": 5, "minLabel": "Unsatisfactory", "maxLabel": "Outstanding" }
    },
    {
      "key": "academic_suggestions",
      "type": "TEXT",
      "section": "Feedback",
      "prompt": "What specific improvements or curriculum adjustments would you recommend?",
      "required": false,
      "maxLength": 500
    }
  ]
