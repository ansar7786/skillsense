      "rating": { "min": 1, "max": 5, "minLabel": "Too Slow / Rushed", "maxLabel": "Optimal Pace" }
    },
    {
      "key": "study_material",
      "type": "RATING",
      "section": "Learning Resources",
      "prompt": "Rate the relevance and completeness of recommended textbooks, notes, and LMS resources.",
      "required": true,
      "rating": { "min": 1, "max": 5, "minLabel": "Inadequate", "maxLabel": "Comprehensive" }
    },
    {
      "key": "fairness_of_assessment",
      "type": "RATING",
      "section": "Evaluation",
      "prompt": "How fair, timely, and transparent were the internal assessments and lab evaluations?",
