      ]
    },
    {
      "name": "04 Surveys & Engine",
      "item": [
        {
          "name": "Get Category Preset (PLACEMENT)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/survey-presets/PLACEMENT",
              "host": ["{{baseUrl}}"],
              "path": ["survey-presets", "PLACEMENT"]
            }
          }
        },
        {
          "name": "Calculate Eligible Student Count",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scope\": \"ALL\",\n  \"branches\": [],\n  \"years\": [],\n  \"sections\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/surveys/eligible-count",
              "host": ["{{baseUrl}}"],
              "path": ["surveys", "eligible-count"]
            }
          }
        },
        {
          "name": "List Surveys (Filtered by Scope)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/surveys?termId=&category=&status=",
              "host": ["{{baseUrl}}"],
              "path": ["surveys"],
              "query": [
                { "key": "termId", "value": "" },
                { "key": "category", "value": "" },
                { "key": "status", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Survey Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
