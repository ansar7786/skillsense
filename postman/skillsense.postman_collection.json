              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {\n    \"java_skill\": 4,\n    \"python_skill\": 3,\n    \"dsa_skill\": 4,\n    \"aptitude_skill\": 4,\n    \"communication_skill\": 3,\n    \"mock_interviews\": \"1-2\",\n    \"projects_completed\": \"2\",\n    \"has_certification\": \"YES\",\n    \"target_role\": \"sde\",\n    \"main_blocker\": \"Balancing semester exams with coding prep\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/my/surveys/{{surveyId}}/submit",
