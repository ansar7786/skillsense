            ],
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["surveys", "{{surveyId}}"]
            }
          }
        },
        {
          "name": "Activate Survey",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}/activate",
              "host": ["{{baseUrl}}"],
              "path": ["surveys", "{{surveyId}}", "activate"]
            }
          }
        },
        {
          "name": "Close Survey",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["surveys", "{{surveyId}}", "close"]
            }
          }
        },
        {
          "name": "Create New Version of Survey",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"termId\": {{termId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}/new-version",
              "host": ["{{baseUrl}}"],
              "path": ["surveys", "{{surveyId}}", "new-version"]
            }
          }
